# Coverage-Konfiguration (coverage.py; gelesen von pytest-cov).
# Quelle: https://coverage.readthedocs.io/en/latest/config.html
[run]
# Line- UND Branch-Coverage (coverage-Doku: https://coverage.readthedocs.io/en/latest/branch.html).
# Aktiviert zusätzlich per `--cov-branch` in pytest.ini.
branch = True

[report]
# Ausgenommen wird NUR der __main__-Guard (Standard-Ausschluss laut
# coverage-Doku „excluding code"): diese Zeile kann ein Import nie erreichen.
# Es wird KEINE weitere Zeile versteckt.
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
